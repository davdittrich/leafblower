#!/bin/sh
# Detect C++17 support.
# $CXX may be "g++ -std=gnu++17" (includes flags); eval+unquoted handles that.
if eval $CXX -std=c++17 -x c++ -c /dev/null -o /dev/null 2>/dev/null; then
    CXXFLAGS_STD="-std=c++17"
else
    CXXFLAGS_STD="-std=c++14"
    echo "WARNING: C++17 not available; falling back to C++14" >&2
fi

# NOTE: the package no longer sets its own optimization (-O) level. R already
# supplies the user/site -O level via $(CXXFLAGS) in $(ALL_CXXFLAGS), and
# tools:::.check_make_vars flags both PKG_CXXFLAGS containing -O* ("pflags") and
# any mutation of the user CXXFLAGS variable ("uflags"). A user wanting -O3 sets
# it in ~/.R/Makevars. (WRE §1.2.1: "flags such as -O2 ... are all specific to
# GCC" — packages must not hard-code them.)

# Detect OpenMP simd hints (-fopenmp-simd, no threading runtime required).
# This is probed independently: a user may have simd vectorisation annotations
# supported by the compiler (-fopenmp-simd) without a full OMP threading runtime.
_lbw_tmp=$(mktemp -d /tmp/lbw_XXXXXX)
LBW_HAS_OMP_SIMD=0
SIMD_FLAGS=""
cat > ${_lbw_tmp}/simd_test.cpp << 'EOF'
int main() {
    double a[8] = {};
    #pragma omp simd
    for (int i = 0; i < 8; i++) a[i] = i * 2.0;
    return a[0] != 0.0;   /* prevents dead-code elim */
}
EOF
if eval $CXX -fopenmp-simd -x c++ ${_lbw_tmp}/simd_test.cpp \
       -o ${_lbw_tmp}/simd_test 2>/dev/null && \
   ${_lbw_tmp}/simd_test 2>/dev/null; then
    LBW_HAS_OMP_SIMD=1
    SIMD_FLAGS="-fopenmp-simd"   # provisional; cleared below if full OMP takes over
    echo "configure: -fopenmp-simd detected — omp simd hints enabled"
fi

# Detect full OpenMP (threading runtime required for LBW_HAS_OMP).
# Compile and link in separate steps so SHLIB_OPENMP_CXXFLAGS appears only once
# per eval $CXX invocation. Run the binary to confirm the runtime works.
LBW_HAS_OMP=0
OMP_FLAGS=""
if [ -n "${SHLIB_OPENMP_CXXFLAGS}" ]; then
    cat > ${_lbw_tmp}/omp_test.cpp << 'EOF'
#include <omp.h>
int main() { return omp_get_max_threads() > 0 ? 0 : 1; }
EOF
    if eval $CXX ${SHLIB_OPENMP_CXXFLAGS} -x c++ -c ${_lbw_tmp}/omp_test.cpp \
           -o ${_lbw_tmp}/omp_test.o 2>/dev/null && \
       eval $CXX ${SHLIB_OPENMP_CXXFLAGS} ${_lbw_tmp}/omp_test.o \
           -o ${_lbw_tmp}/omp_test 2>/dev/null && \
       ${_lbw_tmp}/omp_test 2>/dev/null; then
        OMP_FLAGS="${SHLIB_OPENMP_CXXFLAGS}"
        LBW_HAS_OMP=1
        LBW_HAS_OMP_SIMD=1   # full OMP implies simd support
        SIMD_FLAGS=""          # -fopenmp already covers simd; no redundant flag needed
        echo "configure: OpenMP detected — threading and simd enabled"
    else
        echo "configure: OpenMP not available — serial / simd-only fallback"
    fi
fi

# Detect glibc libmvec (_ZGVdN4v_exp — AVX2, 4-wide double, glibc >= 2.22).
# _ZGVdN4v_exp is in libmvec.so, NOT libm.so. Linker flag must be -lmvec.
# -mavx2 is required so the __m256d intrinsics in lbw_math.hpp compile; it is
# substituted into PKG_CXXFLAGS via the @MAVX2_FLAG@ placeholder (see Makevars.in).
# R CMD check's tools:::.check_make_vars greps the SHIPPED Makevars.in (paths[1L]),
# which contains the opaque placeholder, so PKG_CXXFLAGS stays portable-flag-clean.
LBW_HAS_GLIBC_MVEC=0
MVEC_LIBS=""
MAVX2_FLAG=""
cat > ${_lbw_tmp}/mvec_test.cpp << 'EOF'
#include <immintrin.h>
extern "C" __m256d _ZGVdN4v_exp(__m256d);
int main() {
    __m256d x = _mm256_set1_pd(1.0);
    __m256d r = _ZGVdN4v_exp(x);
    (void)r; return 0;
}
EOF
if eval $CXX -mavx2 ${_lbw_tmp}/mvec_test.cpp \
       -o ${_lbw_tmp}/mvec_test -lm -lmvec 2>/dev/null && \
   ${_lbw_tmp}/mvec_test 2>/dev/null; then
    LBW_HAS_GLIBC_MVEC=1
    MVEC_LIBS="-lm -lmvec"
    MAVX2_FLAG="-mavx2"
    echo "configure: glibc libmvec detected — vectorised exp enabled for L-BFGS-B"
else
    echo "configure: glibc libmvec not available — scalar exp fallback"
fi
rm -rf "${_lbw_tmp}"

cat > src/lbw_config.h << EOF
/* Auto-generated by configure — do not edit. */
#ifndef LBW_CONFIG_H
#define LBW_CONFIG_H
#define LBW_HAS_OMP_SIMD ${LBW_HAS_OMP_SIMD}
#define LBW_HAS_OMP ${LBW_HAS_OMP}
#define LBW_HAS_GLIBC_MVEC ${LBW_HAS_GLIBC_MVEC}
#endif /* LBW_CONFIG_H */
EOF

sed "s|@CXXFLAGS_STD@|${CXXFLAGS_STD}|;s|@OMP_FLAGS@|${OMP_FLAGS}|;s|@SIMD_FLAGS@|${SIMD_FLAGS}|;s|@MAVX2_FLAG@|${MAVX2_FLAG}|;s|@MVEC_LIBS@|${MVEC_LIBS}|" \
    src/Makevars.in > src/Makevars
