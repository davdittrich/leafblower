#!/bin/sh
# Windows counterpart to `configure`. Rtools runs this through its own shell.
#
# Unlike the Unix `configure`, this script runs NO feature probes. On Windows
# the outcome of every probe the Unix script runs is already determined:
#   - glibc's libmvec (_ZGVdN4v_exp) is Linux-only, so LBW_HAS_GLIBC_MVEC is
#     always 0 here and the AVX2 intrinsics in lbw_math.hpp must stay compiled
#     out.
#   - LBW_HAS_OMP and LBW_HAS_OMP_SIMD are read by no source file (grep over
#     src/*.cpp,*.hpp confirms it) — only bare `#pragma omp simd` hints exist,
#     which need no runtime and no link flag. Probing for them would add
#     Windows-toolchain-specific failure modes for zero information gained,
#     so both are hardcoded to 0.
# Do NOT "restore" the probes — their result is architecturally fixed on this
# platform, not merely usually the same.

cat > src/lbw_config.h << EOF
/* Auto-generated by configure.win — do not edit. */
#ifndef LBW_CONFIG_H
#define LBW_CONFIG_H
#define LBW_HAS_OMP_SIMD 0
#define LBW_HAS_OMP 0
#define LBW_HAS_GLIBC_MVEC 0
#endif /* LBW_CONFIG_H */
EOF

# Substitute the same src/Makevars.in the Unix configure uses, so the two
# platforms cannot drift on the next flag change. OMP_FLAGS, MAVX2_FLAG and
# MVEC_LIBS are emptied: PKG_LIBS in Makevars.in has no OpenMP entry, and on
# PE/COFF an unresolved symbol at link time is a hard error (unlike ELF), so
# no flag may be added here that isn't matched by a corresponding PKG_LIBS
# entry on both platforms. -fopenmp-simd needs no runtime library and is
# accepted by every Rtools GCC since 4.9 and by the LLVM-based aarch64
# toolchain.
sed "s|@CXXFLAGS_STD@|-std=c++17|;s|@OMP_FLAGS@||;s|@SIMD_FLAGS@|-fopenmp-simd|;s|@MAVX2_FLAG@||;s|@MVEC_LIBS@||" \
    src/Makevars.in > src/Makevars.win
